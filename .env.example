# AGI Platform Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Mind Component Configuration
# ==========================================

# API Server
MIND_PORT=8000

# Model Provider (anthropic, openai, local)
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-5-20250929
API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI (if using OpenAI models)
# OPENAI_API_KEY=your_openai_key_here

# ==========================================
# Database Configuration
# ==========================================

# PostgreSQL
POSTGRES_DB=agi_memory
POSTGRES_USER=agi
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ==========================================
# Memory Configuration
# ==========================================

# Context and Memory Settings
MAX_CONTEXT_WINDOW=200000
MEMORY_RETENTION_DAYS=365
EMBEDDING_MODEL=text-embedding-3-small

# Vector Search
VECTOR_DIMENSIONS=1536
SIMILARITY_THRESHOLD=0.7

# ==========================================
# Operational Settings
# ==========================================

# Logging
LOG_LEVEL=info  # debug, info, warning, error

# Features
ENABLE_WEBSOCKET=true
SANDBOX_ENABLED=true

# Performance
WORKER_COUNT=4
TIMEOUT_SECONDS=300

# ==========================================
# Recursive Agent Architecture
# ==========================================

# Recursion Limits
MAX_TREE_DEPTH=10
MAX_AGENTS_PER_TASK=100
MAX_SUBAGENTS_PER_AGENT=5

# Agent Execution
AGENT_TIMEOUT_SECONDS=300
MAX_TOOL_CALLS_PER_AGENT=20

# Code Execution
CODE_SANDBOX_ENABLED=true
CODE_EXECUTION_TIMEOUT=30
ALLOWED_LANGUAGES=python,javascript,bash

# ==========================================
# Safety & Limits
# ==========================================

# Reasoning Limits
MAX_REASONING_STEPS=100
MAX_TOOL_CALLS_PER_TASK=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cost Controls
COST_LIMIT_PER_TASK=10.00
COST_LIMIT_PER_HOUR=100.00

# Human Oversight
REQUIRE_HUMAN_APPROVAL=false
ENABLE_HUMAN_REVIEW=false
APPROVAL_TIMEOUT_SECONDS=300

# ==========================================
# Development Settings
# ==========================================

# Environment
ENVIRONMENT=production  # development, staging, production

# Debug
DEBUG=false
ENABLE_PROFILING=false
