# Docker-specific environment configuration
# This file contains sensible defaults for Docker deployment
# Copy to .env and customize with your API key

# REQUIRED: Your Anthropic API key
ANTHROPIC_API_KEY=

# Memory Configuration
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
MEMORY_COLLECTION_NAME=agi_memories

# Agent Configuration
DEFAULT_MODEL=claude-sonnet-4-5-20250929
MAX_MEMORY_RESULTS=5
MEMORY_RELEVANCE_THRESHOLD=0.7

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Custom tools directory
# CUSTOM_TOOLS_DIR=/app/tools

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
